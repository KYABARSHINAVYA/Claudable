DATABASE_URL="file:../data/cc.db"
PROJECTS_DIR="./data/projects"
ENCRYPTION_KEY="replace-with-64-hex-chars"
PORT=3000
WEB_PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE="http://localhost:3000"
PREVIEW_PORT_START=3100
PREVIEW_PORT_END=3999

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://dwosgvjsonbsihsiugdh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloud workspace containers
CLOUD_WORKSPACES_ENABLED="true"
CLOUD_WORKSPACES_REQUIRED="true"
CLOUD_WORKSPACE_IMAGE="node:20-bookworm"

# Gemini-backed agent provider configuration.
# A raw Gemini API key is useful for Gemini services, but Claude Agent SDK
# needs an agent-compatible gateway in front of Gemini to preserve
# the full agentic coding workflow.
GEMINI_AGENT_PROVIDER="gemini-compatible"
GEMINI_AGENT_BASE_URL=""
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# GLM/Z.ai agent runtime
GLM_ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
ZHIPU_API_KEY=""
